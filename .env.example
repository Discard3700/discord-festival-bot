# Required — Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional — restrict slash commands to one guild (instant propagation during dev)
# Leave empty to register globally (takes up to 1 hour to propagate)
GUILD_ID=

# PostgreSQL connection string
# Local dev (docker compose): postgresql://festival:festival@db:5432/festival
# Synology NAS: postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# IANA timezone for displaying set times (default: UTC)
# Examples: America/Chicago, America/New_York, America/Los_Angeles
FESTIVAL_TZ=
